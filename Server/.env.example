# Server Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Port for the Node.js / Express backend server
PORT=5001

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bilingual-chat?retryWrites=true&w=majority

# JWT Secret Key for token generation & verification
JWT_SECRET=your_super_secret_jwt_key_here

# JWT Expiration time (e.g. 7d, 24h, 3600s)
JWT_EXPIRES_IN=7d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:4200
